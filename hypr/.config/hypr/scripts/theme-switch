#!/usr/bin/env python3
"""Switch the desktop between light (day) and dark (night) at sunrise/sunset.

Usage:
  theme-switch auto            apply the mode for the current time (no-op if already applied)
  theme-switch apply light|dark
  theme-switch toggle          manual override until the next sunrise/sunset
  theme-switch daemon          run `auto` every minute (started from hyprland.lua)
  theme-switch sun             print today's sunrise/sunset and the scheduled mode

Set THEME_SWITCH_NOW="2026-10-01 18:30" to fake the current time when testing `auto`/`sun`.
"""
import math
import os
import shutil
import subprocess
import sys
import time
from datetime import datetime, timedelta, date

# ---- settings ------------------------------------------------------------
LATITUDE = 35.69    # Tehran
LONGITUDE = 51.39
WALLPAPER = {
    "light": "~/wallpapers/sea_sunrise_3-wallpaper-1920x1080.jpg",
    "dark":  "~/wallpapers/moonlit_peaks-wallpaper-1920x1080.jpg",
}
GTK_THEME = {"light": "adw-gtk3", "dark": "adw-gtk3-dark"}
QT_COLORS = {"light": "/usr/share/qt5ct/colors/airy.conf", "dark": "/usr/share/qt5ct/colors/darker.conf"}
POLL_SECONDS = 60
# --------------------------------------------------------------------------

HOME = os.path.expanduser("~")
CFG = os.path.join(HOME, ".config")
CACHE = os.path.join(HOME, ".cache")
MODE_FILE = os.path.join(CACHE, "theme-mode")
OVERRIDE_FILE = os.path.join(CACHE, "theme-override")


def now():
    fake = os.environ.get("THEME_SWITCH_NOW")
    return datetime.strptime(fake, "%Y-%m-%d %H:%M") if fake else datetime.now()


def sun_times(day: date):
    """Sunrise/sunset as naive local datetimes (NOAA general solar position algorithm)."""
    n = day.timetuple().tm_yday
    gamma = 2 * math.pi / 365 * (n - 1)
    eqtime = 229.18 * (0.000075 + 0.001868 * math.cos(gamma) - 0.032077 * math.sin(gamma)
                       - 0.014615 * math.cos(2 * gamma) - 0.040849 * math.sin(2 * gamma))
    decl = (0.006918 - 0.399912 * math.cos(gamma) + 0.070257 * math.sin(gamma)
            - 0.006758 * math.cos(2 * gamma) + 0.000907 * math.sin(2 * gamma)
            - 0.002697 * math.cos(3 * gamma) + 0.00148 * math.sin(3 * gamma))
    lat = math.radians(LATITUDE)
    cos_ha = (math.cos(math.radians(90.833)) / (math.cos(lat) * math.cos(decl))
              - math.tan(lat) * math.tan(decl))
    ha = math.degrees(math.acos(max(-1.0, min(1.0, cos_ha))))

    midnight = datetime(day.year, day.month, day.day)
    utc_offset = midnight.astimezone().utcoffset() or timedelta(0)

    def at(minutes_utc):
        return midnight + timedelta(minutes=minutes_utc) + utc_offset

    return at(720 - 4 * (LONGITUDE + ha) - eqtime), at(720 - 4 * (LONGITUDE - ha) - eqtime)


def scheduled_mode(t: datetime):
    rise, sset = sun_times(t.date())
    return "light" if rise <= t < sset else "dark"


def next_event(t: datetime):
    for d in range(3):
        for ev in sun_times(t.date() + timedelta(days=d)):
            if ev > t:
                return ev
    return t + timedelta(hours=12)


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)


def run(*cmd):
    try:
        subprocess.run(cmd, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        pass


def symlink(target, link):
    tmp = link + ".tmp"
    if os.path.lexists(tmp):
        os.remove(tmp)
    os.symlink(target, tmp)
    os.replace(tmp, link)


def set_ini(path, key, value):
    if not os.path.exists(path):
        return
    lines = open(path).read().splitlines()
    for i, line in enumerate(lines):
        if line.split("=", 1)[0].strip() == key:
            lines[i] = f"{key}={value}"
            break
    else:
        lines.append(f"{key}={value}")
    write(path, "\n".join(lines) + "\n")


# ---- per-component steps -------------------------------------------------

def hyprland(mode):
    symlink(f"{mode}.lua", os.path.join(CFG, "hypr/theme/current.lua"))
    run("hyprctl", "reload")


def gtk(mode):
    run("gsettings", "set", "org.gnome.desktop.interface", "color-scheme", f"prefer-{mode}")
    run("gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", GTK_THEME[mode])
    for v in ("gtk-3.0", "gtk-4.0"):
        ini = os.path.join(CFG, v, "settings.ini")
        set_ini(ini, "gtk-application-prefer-dark-theme", "1" if mode == "dark" else "0")
        set_ini(ini, "gtk-theme-name", GTK_THEME[mode])


def waybar(mode):
    symlink(f"colors-{mode}.css", os.path.join(CFG, "waybar/colors.css"))
    run("pkill", "-SIGUSR2", "-x", "waybar")


def wofi(mode):
    symlink(f"colors-{mode}.css", os.path.join(CFG, "wofi/colors.css"))


def dunst(mode):
    d = os.path.join(CFG, "dunst/dunstrc.d")
    shutil.copyfile(os.path.join(d, f"theme-{mode}.conf.src"), os.path.join(d, "50-theme.conf"))
    run("dunstctl", "reload")


def qt(mode):
    for v in ("qt5ct", "qt6ct"):
        conf = os.path.join(CFG, v, f"{v}.conf")
        if os.path.exists(conf):
            colors = QT_COLORS[mode].replace("qt5ct", v)
            text = open(conf).read().splitlines()
            text = [f"color_scheme_path={colors}" if l.startswith("color_scheme_path=") else l for l in text]
            write(conf, "\n".join(text) + "\n")


def wallpaper(mode):
    path = os.path.expanduser(WALLPAPER[mode])
    if not os.path.exists(path):
        return
    # Keep hyprpaper.conf in sync so the right wallpaper shows at next login
    write(os.path.join(CFG, "hypr/hyprpaper.conf"), f"preload = {path}\nwallpaper = , {path}\n")
    # hyprctl's hyprpaper IPC is incompatible with hyprpaper 0.7.x, so restart it with the new config
    run("pkill", "-x", "hyprpaper")
    time.sleep(0.3)
    subprocess.Popen(["hyprpaper"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


# waybar first so the bar (and its theme toggle icon) updates instantly
STEPS = [waybar, hyprland, gtk, wofi, dunst, qt, wallpaper]


def apply(mode, notify=True):
    # Written first: waybar's theme icon reads it when the waybar step reloads the bar
    write(MODE_FILE, mode)
    for step in STEPS:
        try:
            step(mode)
        except Exception as e:  # one broken component must not block the rest
            print(f"theme-switch: {step.__name__}: {e}", file=sys.stderr)
    if notify:
        run("notify-send", "-a", "theme-switch", "-t", "2500",
            "Light mode" if mode == "light" else "Dark mode",
            "Sunrise/sunset schedule" if not os.path.exists(OVERRIDE_FILE) else "Manual override")


# ---- commands ------------------------------------------------------------

def desired_mode(t):
    override = read(OVERRIDE_FILE)
    if override:
        mode, _, until = override.partition(" ")
        try:
            if t < datetime.fromisoformat(until):
                return mode
        except ValueError:
            pass
        os.remove(OVERRIDE_FILE)
    return scheduled_mode(t)


def cmd_auto(force=False):
    mode = desired_mode(now())
    if force or read(MODE_FILE) != mode:
        apply(mode)


def cmd_toggle():
    t = now()
    mode = "dark" if (read(MODE_FILE) or scheduled_mode(t)) == "light" else "light"
    write(OVERRIDE_FILE, f"{mode} {next_event(t).isoformat(timespec='minutes')}")
    apply(mode)


def cmd_daemon():
    # Single instance: a config reload must not stack daemons
    lock = os.path.join(CACHE, "theme-switch.pid")
    pid = read(lock)
    if pid and pid.isdigit() and int(pid) != os.getpid() and os.path.exists(f"/proc/{pid}") \
            and "theme-switch" in (read(f"/proc/{pid}/cmdline") or ""):
        return
    write(lock, str(os.getpid()))
    cmd_auto(force=True)
    while True:
        time.sleep(POLL_SECONDS)
        cmd_auto()


def cmd_sun():
    t = now()
    rise, sset = sun_times(t.date())
    print(f"now      {t:%Y-%m-%d %H:%M}")
    print(f"sunrise  {rise:%H:%M}")
    print(f"sunset   {sset:%H:%M}")
    print(f"schedule {scheduled_mode(t)}   current {read(MODE_FILE, '-')}   override {read(OVERRIDE_FILE, '-')}")


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "auto"
    if cmd == "auto":
        cmd_auto()
    elif cmd == "apply" and len(argv) > 2 and argv[2] in ("light", "dark"):
        apply(argv[2])
    elif cmd == "toggle":
        cmd_toggle()
    elif cmd == "daemon":
        cmd_daemon()
    elif cmd == "sun":
        cmd_sun()
    else:
        print(__doc__)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
