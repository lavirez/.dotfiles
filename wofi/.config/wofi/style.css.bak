#window {
    background-color: transparent;
}

#outer-box {
    border-radius: 18px;
    background-color: rgba(24, 26, 30, 0.60);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.10), 0 16px 40px rgba(0, 0, 0, 0.32);
}

#input {
    padding: 10px 12px;
    border-radius: 18px 18px 0 0;
    font-size: 16px;
    font-family: "SF Pro Text", "San Francisco", "Inter", sans-serif;
    background-color: rgba(255, 255, 255, 0.06);
    border: none;
    color: #f8fafc;
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}

#input:focus {
    box-shadow: none;
}

#scroll {
    border-radius: 0 0 18px 18px;
    background-color: rgba(20, 22, 26, 0.55);
    margin: 0;
}

#inner-box {
    border-radius: 0 0 18px 18px;
    padding: 12px;
}

#entry {
    padding: 10px;
    border-radius: 10px;
    color: #eef2f7;
}

#entry:selected {
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.14);
    color: #ffffff;
}

#entry image {
    margin-right: 10px;
}