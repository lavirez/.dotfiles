{
	"position": "top",
	"margin": "8 16 0",
	"mode": "dock",
	"modules-left": [
		"group/workspaces"
	],
	"modules-center": [
		"custom/clock"
	],
	"modules-right": [
		"tray",
		"network",
		"bluetooth",
		"temperature",
		"pulseaudio",
		"custom/theme"
	],
	"group/workspaces": {
		"orientation": "horizontal",
		"modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10"]
	},
	"custom/ws1": {"exec": "~/.config/waybar/scripts/workspace.py 1 '󰊠' --persistent", "return-type": "json", "format": "{}", "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"},
	"custom/ws2": {"exec": "~/.config/waybar/scripts/workspace.py 2 '󰈹' --persistent", "return-type": "json", "format": "{}", "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'"},
	"custom/ws3": {"exec": "~/.config/waybar/scripts/workspace.py 3 '' --persistent", "return-type": "json", "format": "{}", "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'"},
	"custom/ws4": {"exec": "~/.config/waybar/scripts/workspace.py 4 '4' --persistent", "return-type": "json", "format": "{}", "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'"},
	"custom/ws5": {"exec": "~/.config/waybar/scripts/workspace.py 5 '5' --persistent", "return-type": "json", "format": "{}", "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'"},
	"custom/ws6": {"exec": "~/.config/waybar/scripts/workspace.py 6 '6'", "return-type": "json", "format": "{}", "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'"},
	"custom/ws7": {"exec": "~/.config/waybar/scripts/workspace.py 7 '7'", "return-type": "json", "format": "{}", "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'"},
	"custom/ws8": {"exec": "~/.config/waybar/scripts/workspace.py 8 ''", "return-type": "json", "format": "{}", "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'"},
	"custom/ws9": {"exec": "~/.config/waybar/scripts/workspace.py 9 '󰆟' --persistent", "return-type": "json", "format": "{}", "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 9 })'"},
	"custom/ws10": {"exec": "~/.config/waybar/scripts/workspace.py 10 '󰕼'", "return-type": "json", "format": "{}", "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 10 })'"},
	"custom/theme": {"exec": "~/.config/waybar/scripts/theme-icon", "return-type": "json", "interval": 30, "signal": 8, "on-click": "~/.config/hypr/scripts/theme-switch toggle; pkill -RTMIN+8 -x waybar"},
	"hyprland/window": {
		"format": "{}",
		"icon": true,
		"icon-size": 25
	},
	"hyprland/workspaces": {
		"format": "{icon}",
		"icon-size": 31,
		"format-icons": {
			"1": "󰊠",
			"2": "󰈹",
			"3": "",
            "8": "",
            "9": "󰆟",
			"10": "󰕼"
		},
		"persistent-workspaces": {
			"*": [
				1,
				2,
				3,
				4,
				5,
				9
			]
		}
	},
	"tray": {
		"icon-size": 18,
		"spacing": 20
	},
	"network": {
		"format-icons": [
			"󰤟",
			"󰤢",
			"󰤥",
			"󰤨"
		],
		"format-wifi": "{icon}",
		"format-ethernet": "",
		"format-linked": "󰄡",
		"format-disconnected": "",
		"tooltip-format": "{essid} ({signalStrength}%) - {gwaddr}",
		"tooltip-format-ethernet": "{ifname} - {gwaddr}",
		"tooltip-format-disconnected": "Disconnected"
	},
	"bluetooth": {
		"format": "󰂯",
		"format-disabled": "󰂲",
		"format-connected": "󰂱 {num_connections}",
		"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
		"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
		"on-click": "bluetooth toggle"
	},
	"battery": {
		"full-at": 95,
		"states": {
			"warning": 35,
			"critical": 10
		},
		"format": "{icon}",
		"format-plugged": "",
		"format-charging": "󰂄",
		"format-icons": [
			"󰂎",
			"󰁺",
			"󰁻",
			"󰁼",
			"󰁽",
			"󰁾",
			"󰁿",
			"󰂀",
			"󰂁",
			"󰂂",
			"󰁹"
		],
		"tooltip-format": "{capacity}%"
	},
	"temperature": {
		"hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
		"input-filename": "temp1_input",
		"format": " {temperatureC}°C",
		"critical-threshold": 80
	},
	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": "󰝟 0%",
		"on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
		"on-click-right": "pavucontrol",
		"on-scroll-up": "wpctl set-volume -l 1.3 @DEFAULT_SINK@ 5%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 5%-",
		"scroll-step": 5,
		"format-icons": {
			"headphone": "󱡏",
			"hands-free": "󱡏",
			"headset": "󱡏",
			"default": [
				"",
				""
			]
		}
	},
	"custom/clock": {
		"exec": "~/.config/waybar/scripts/clock-calendar.py",
		"return-type": "json",
		"interval": 10,
		"signal": 9,
		"on-scroll-up": "~/.config/waybar/scripts/clock-calendar.py shift -1; pkill -RTMIN+9 -x waybar",
		"on-scroll-down": "~/.config/waybar/scripts/clock-calendar.py shift 1; pkill -RTMIN+9 -x waybar",
		"on-click-right": "~/.config/waybar/scripts/clock-calendar.py shift 0; pkill -RTMIN+9 -x waybar"
	},
	"backlight": {
		"device": "intel_backlight",
		"format": "{icon} {percent}%",
		"format-icons": [
			"󰃞",
			"󰃟",
			"󰃠"
		],
		"on-scroll-up": "brightnessctl set 10%+",
		"on-scroll-down": "brightnessctl set 10%-",
		"min-length": 6
	},
	"pulseaudio#microphone": {
		"format": "{format_source}",
		"format-source": " {volume}%",
		"format-source-muted": " Muted",
		"on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
		"on-click-right": "pavucontrol",
		"on-scroll-up": "wpctl set-volume -l 1.3 @DEFAULT_SOURCE@ 5%+",
		"on-scroll-down": "wpctl set-volume -l 1.3 @DEFAULT_SOURCE@ 5%-",
		"scroll-step": 5
	}
}
