* {
    font-family: "SF Pro Display", "SF Pro Text", "Helvetica Neue", sans-serif;
    font-weight: 600;
    font-size: 13px;
}

window#waybar {
    border-radius: 18px;
    background: rgba(24, 26, 30, 0.60);
    color: #eef2f7;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.10), 0 16px 40px rgba(0, 0, 0, 0.24);
}

tooltip {
    background: rgba(24, 26, 30, 0.82);
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
}

tooltip label {
    padding: 6px 12px;
    color: #f8fafc;
}

#workspaces {
    margin: 4px 0;
    padding: 0 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
}

#workspaces button {
	    min-width: 24px;
	    border-radius: 999px;
	    margin: 4px 0;
	    padding: 0 8px;
	    color: #eef2f7;
}

#workspaces button:not(:last-child) {
	    margin-right: 2px;
}

#workspaces button:hover {
	    background: rgba(255, 255, 255, 0.12);
}

#workspaces button.active,
#workspaces button.active:hover {
	    background: rgba(255, 255, 255, 0.18);
	    color: #ffffff;
	    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.28),
        0 1px 3px rgba(0, 0, 0, 0.32);
}

#clock,
#battery,
#pulseaudio,
#network,
#bluetooth,
#temperature,
#workspaces,
#backlight {
    padding: 0 12px;
    background-color: transparent;
}

#tray {
    padding: 0 12px;
}

#network {
    border-radius: 0;
    padding-left: 12px;
}

#workspaces {
    background-clip: padding-box;
}

#battery.warning {
    color: #f0c674;
}

#battery.critical {
    color: #ff7a7a;
    border-color: transparent;
}

#temperature.critical {
    color: #ff7a7a;
    border-color: transparent;
}

#clock {
    padding-right: 12px;
    border-radius: 0;
}
